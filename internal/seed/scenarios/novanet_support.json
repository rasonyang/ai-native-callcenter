{
  "scenarios": [
    {
      "name": "english caller asks for a person",
      "lang": "en",
      "caller": "8005550100",
      "queues": ["support-en", "support-zh"],
      "steps": [
        {"exchange": "My internet is down, let me talk to somebody."},
        {"call": "transfer_to_agent", "args": {"queue": "support-en", "reason": "CALLER_REQUEST", "summary": "Internet is down."},
          "expect": {"phase": "finish_transfer"}}
      ],
      "expect": {"path": ["welcome", "finish_transfer"], "ending": "transfer_to_agent",
        "transfer": {"queue": "support-en", "reason": "CALLER_REQUEST"}}
    },
    {
      "name": "chinese caller is sent to the chinese queue",
      "lang": "zh",
      "caller": "8005550101",
      "queues": ["support-en", "support-zh"],
      "steps": [
        {"call": "transfer_to_agent", "args": {"queue": "support-zh", "reason": "CALLER_REQUEST", "summary": "宽带断网"},
          "expect": {"phase": "finish_transfer"}}
      ],
      "expect": {"ending": "transfer_to_agent", "transfer": {"queue": "support-zh"}}
    },
    {
      "name": "a queue that does not exist is refused",
      "lang": "en",
      "caller": "8005550102",
      "queues": ["support-en", "support-zh"],
      "steps": [
        {"call": "transfer_to_agent", "args": {"queue": "customer_service", "reason": "CALLER_REQUEST", "summary": "x"},
          "expect": {"isOk": false, "phase": "welcome"}}
      ],
      "expect": {"path": ["welcome"], "ending": "none"}
    },
    {
      "name": "transfer refused, the bot offers a message",
      "lang": "en",
      "caller": "8005550103",
      "actions": {"transfer_to_agent": {"isOk": false, "error": "the queue is closed"}},
      "steps": [
        {"call": "transfer_to_agent", "args": {"queue": "support-en", "reason": "CALLER_REQUEST", "summary": "x"},
          "expect": {"isOk": false, "phase": "welcome"}},
        {"call": "take_message", "args": {"message": "router keeps rebooting", "callbackNumber": "8005550103"}, "expect": {"phase": "welcome"}},
        {"call": "hangup", "args": {"reason": "CALLER_DECLINED_MORE_HELP"}, "expect": {"phase": "farewell"}}
      ],
      "expect": {"path": ["welcome", "farewell"], "ending": "hangup"}
    },
    {
      "name": "caller says goodbye",
      "lang": "en",
      "caller": "8005550104",
      "steps": [
        {"call": "hangup", "args": {"reason": "CALLER_GOODBYE"}, "expect": {"phase": "farewell"}}
      ],
      "expect": {"path": ["welcome", "farewell"], "ending": "hangup"}
    },
    {
      "name": "english caller has the wrong number (#554)",
      "description": "A caller who says at the greeting that the call is a mistake is let go at once: the welcome opens with the case, hangup with CALLER_ASKED_TO_END goes straight to the farewell line.",
      "lang": "en",
      "caller": "8005550110",
      "steps": [
        {"say": "Wrong number, sorry.", "expect": {"phase": "welcome", "instructionContains": [
          "If the caller says this call is a mistake",
          "call hangup with reason CALLER_ASKED_TO_END straight away: do not reassure them first, do not ask again how you can help"]}},
        {"call": "hangup", "args": {"reason": "CALLER_ASKED_TO_END"},
          "expect": {"phase": "farewell", "announce": "Thank you for calling NovaNet. Goodbye."}}
      ],
      "expect": {"path": ["welcome", "farewell"], "ending": "hangup", "hangupReason": "CALLER_ASKED_TO_END", "toolsRun": ["hangup"]}
    },
    {
      "name": "chinese caller has the wrong number (#554)",
      "description": "The same in Chinese.",
      "lang": "zh",
      "caller": "8005550111",
      "steps": [
        {"say": "不好意思，拨错电话了。", "expect": {"phase": "welcome", "instructionContains": [
          "来电者说这通电话打错了",
          "直接调用 hangup，reason 用 CALLER_ASKED_TO_END：不要先说“没关系”这类的话，不要再问有什么可以帮您"]}},
        {"call": "hangup", "args": {"reason": "CALLER_ASKED_TO_END"},
          "expect": {"phase": "farewell", "announce": "感谢您致电 NovaNet，再见。"}}
      ],
      "expect": {"path": ["welcome", "farewell"], "ending": "hangup", "hangupReason": "CALLER_ASKED_TO_END", "toolsRun": ["hangup"]}
    },
    {
      "name": "a hangup with no reason is refused and the call goes on (#484)",
      "lang": "en",
      "caller": "8005550109",
      "steps": [
        {"say": "What service do you offer?"},
        {"call": "hangup", "expect": {"isRefused": true, "phase": "welcome",
          "result": {"ok": "0", "error": "hangup needs a reason, one of CALLER_GOODBYE, CALLER_DECLINED_MORE_HELP, CALLER_ASKED_TO_END, FLOW_INSTRUCTED; the call was not ended"}}},
        {"call": "hangup", "args": {"reason": "CALLER_LEFT"}, "expect": {"isRefused": true, "phase": "welcome"}},
        {"say": "No, that's all, thanks. Bye."},
        {"call": "hangup", "args": {"reason": "CALLER_GOODBYE"}, "expect": {"phase": "farewell"}}
      ],
      "expect": {"path": ["welcome", "farewell"], "ending": "hangup", "toolsRun": ["hangup"]}
    },
    {
      "name": "three silences end the call",
      "lang": "en",
      "caller": "8005550105",
      "steps": [
        {"noInput": true, "expect": {"phase": "welcome"}},
        {"noInput": true, "expect": {"phase": "welcome"}},
        {"noInput": true, "expect": {"phase": "farewell"}}
      ],
      "expect": {"path": ["welcome", "farewell"]}
    },
    {
      "name": "speech between silences restarts the count",
      "lang": "en",
      "caller": "8005550106",
      "steps": [
        {"noInput": true},
        {"noInput": true},
        {"say": "Hello? Sorry, I was looking for my router."},
        {"noInput": true, "expect": {"phase": "welcome", "slots": {"noInput.count": 1}}}
      ],
      "expect": {"path": ["welcome"]}
    },
    {
      "name": "the model loops on refused transfers until the turn limit",
      "description": "maxTurns is 30: the 31st tool result sends the call to need_transfer.",
      "lang": "en",
      "caller": "8005550107",
      "actions": {"transfer_to_agent": {"isOk": false, "error": "busy"}},
      "steps": [
        {"repeat": 30, "call": "transfer_to_agent", "args": {"queue": "support-en", "reason": "CALLER_REQUEST", "summary": "x"},
          "expect": {"isOk": false, "phase": "welcome"}},
        {"call": "transfer_to_agent", "args": {"queue": "support-en", "reason": "CALLER_REQUEST", "summary": "x"},
          "expect": {"isOk": false, "phase": "need_transfer"}}
      ],
      "expect": {"path": ["welcome", "need_transfer"]}
    },
    {
      "name": "model: english caller asks for a person",
      "description": "Tier 2. The caller wants an agent and the bot transfers to the English queue.",
      "lang": "en",
      "caller": "8005550100",
      "queues": ["support-en", "support-zh"],
      "callerPersona": {
        "goal": "Your home internet has been down all day and you want to talk to a human agent. Ask for one.",
        "behaviour": "Slightly impatient, but polite."
      },
      "model": {"ending": "transfer_to_agent", "transfer": {"queue": "support-en"}, "phase": "finish_transfer"}
    }
  ]
}
