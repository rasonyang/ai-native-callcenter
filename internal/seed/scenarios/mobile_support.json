{
  "scenarios": [
    {
      "name": "来电者打错了电话(#554)",
      "description": "来电者开场就说打错了:hangup 用 CALLER_ASKED_TO_END,通话直接进入结束语(#554)。",
      "lang": "zh",
      "caller": "13800009999",
      "steps": [
        {"say": "拨错号码了。", "expect": {"phase": "welcome"}},
        {"call": "hangup", "args": {"reason": "CALLER_ASKED_TO_END"}, "expect": {"phase": "finish", "announce": "感谢来电,再见。"}}
      ],
      "expect": {"path": ["welcome", "finish"], "ending": "hangup", "hangupReason": "CALLER_ASKED_TO_END", "toolsRun": ["hangup"]}
    },
    {
      "name": "caller checks a repair order that exists",
      "lang": "en",
      "caller": "13800001111",
      "steps": [
        {"exchange": "I want to check my repair."},
        {"call": "repair_status", "args": {"rma": "RMA1001"}, "expect": {
          "phase": "repair_report",
          "result": {"found": "1", "device": "星讯 X1 手机"},
          "slots": {"repair_status.args.rma": "RMA1001"}}},
        {"call": "hangup", "args": {"reason": "CALLER_DECLINED_MORE_HELP"}, "expect": {"phase": "finish"}}
      ],
      "expect": {"path": ["welcome", "repair_report", "finish"], "ending": "hangup", "toolsRun": ["repair_status", "hangup"]}
    },
    {
      "name": "caller corrects a wrong order number after the first lookup found nothing",
      "lang": "en",
      "caller": "13800002222",
      "steps": [
        {"call": "repair_status", "args": {"rma": "RMA0000"}, "expect": {"phase": "welcome", "result": {"found": "0"}}},
        {"call": "repair_status", "args": {"rma": "RMA1002"}, "expect": {"phase": "repair_report", "result": {"found": "1"}}},
        {"call": "repair_status", "args": {"rma": "RMA0001"}, "expect": {"phase": "repair_report", "result": {"found": "0"}}},
        {"call": "repair_status", "args": {"rma": "RMA1001"}, "expect": {"phase": "repair_report_multi", "result": {"found": "1"}}}
      ],
      "expect": {"path": ["welcome", "repair_report", "repair_report_multi"]}
    },
    {
      "name": "the report names the latest order and says when it was not found",
      "description": "The engine keeps the orders found (collect), so a miss after a hit stays out of the list and the one-order phase answers for that order; a second order found moves the call to the phase that asks which one (#116).",
      "lang": "zh",
      "caller": "13800008888",
      "steps": [
        {"call": "repair_status", "args": {"rma": "RMA1001"}, "expect": {"phase": "repair_report",
          "instructionContains": ["单号 RMA1001,found=1", "星讯 X1 手机"]}},
        {"call": "repair_status", "args": {"rma": "RMA9999"}, "expect": {"phase": "repair_report",
          "slots": {"repair_status.foundOrders": "RMA1001", "repair_status.foundOrders.count": 1},
          "instructionContains": ["本通电话查到的维修单只有一张:RMA1001。", "单号 RMA9999,found=0", "说的就是 RMA1001"]}},
        {"call": "repair_status", "args": {"rma": "RMA1002"}, "expect": {"phase": "repair_report_multi",
          "slots": {"repair_status.foundOrders": "RMA1001, RMA1002", "repair_status.foundOrders.count": 2},
          "instructionContains": ["本通电话查到的维修单有 2 张:RMA1001, RMA1002。", "单号 RMA1002,found=1", "星讯 Air 手机",
            "“您这通电话查到了 RMA1001, RMA1002,请问是哪一张?”"]}},
        {"call": "repair_status", "args": {"rma": "RMA9999"}, "expect": {"phase": "repair_report_multi",
          "slots": {"repair_status.foundOrders": "RMA1001, RMA1002", "repair_status.foundOrders.count": 2},
          "instructionContains": ["查到的维修单有 2 张:RMA1001, RMA1002。最近一次查询:单号 RMA9999,found=0"]}},
        {"call": "repair_status", "args": {"rma": "RMA1001"}, "expect": {"phase": "repair_report_multi",
          "slots": {"repair_status.foundOrders": "RMA1001, RMA1002", "repair_status.foundOrders.count": 2},
          "instructionContains": ["最近一次查询:单号 RMA1001,found=1"]}}
      ],
      "expect": {"path": ["welcome", "repair_report", "repair_report_multi"]}
    },
    {
      "name": "three unknown order numbers hand the caller to a person",
      "lang": "zh",
      "caller": "13800003333",
      "queues": ["support-zh"],
      "steps": [
        {"call": "repair_status", "args": {"rma": "RMA0001"}, "expect": {"phase": "welcome"}},
        {"call": "repair_status", "args": {"rma": "RMA0002"}, "expect": {"phase": "welcome"}},
        {"call": "repair_status", "args": {"rma": "RMA0003"}, "expect": {"phase": "need_transfer"}},
        {"call": "transfer_to_agent", "args": {"queue": "support-zh", "reason": "REPAIR_ORDER_NOT_FOUND", "summary": "三次查询均无结果"},
          "expect": {"phase": "finish_transfer"}}
      ],
      "expect": {"path": ["welcome", "need_transfer", "finish_transfer"], "ending": "transfer_to_agent",
        "transfer": {"queue": "support-zh", "reason": "REPAIR_ORDER_NOT_FOUND"}}
    },
    {
      "name": "caller presses 0 straight away",
      "lang": "en",
      "caller": "13800004444",
      "queues": ["support-en"],
      "steps": [
        {"keypress": "0"},
        {"call": "transfer_to_agent", "args": {"queue": "support-en", "reason": "CALLER_REQUEST", "summary": "asked for an agent"},
          "expect": {"phase": "finish_transfer"}}
      ],
      "expect": {"ending": "transfer_to_agent"}
    },
    {
      "name": "transfer refused, caller leaves a message",
      "lang": "en",
      "caller": "13800005555",
      "actions": {"transfer_to_agent": {"isOk": false, "error": "outside business hours"}},
      "steps": [
        {"call": "transfer_to_agent", "args": {"queue": "support-en", "reason": "CALLER_REQUEST", "summary": "x"},
          "expect": {"isOk": false, "phase": "welcome", "result": {"error": "outside business hours"}}},
        {"call": "take_message", "args": {"message": "call me back about the screen"}, "expect": {"phase": "welcome"}}
      ],
      "expect": {"path": ["welcome"], "ending": "take_message"}
    },
    {
      "name": "a bot that only chats is closed by the tool-less wall",
      "description": "maxTurnsWithoutTool is 10: the 11th tool-less reply to the caller sends the call to the closing phase.",
      "lang": "en",
      "caller": "13800006666",
      "steps": [
        {"repeat": 10, "exchange": "and what about the battery?", "expect": {"phase": "welcome"}},
        {"exchange": "and the camera?", "expect": {"phase": "finish"}}
      ],
      "expect": {"path": ["welcome", "finish"]}
    },
    {
      "name": "a tool-using bot is not closed by the wall",
      "lang": "en",
      "caller": "13800007777",
      "steps": [
        {"repeat": 8, "exchange": "hmm"},
        {"call": "repair_status", "args": {"rma": "RMA0001"}},
        {"repeat": 8, "exchange": "hmm", "expect": {"phase": "welcome"}}
      ],
      "expect": {"path": ["welcome"]}
    },
    {
      "name": "model: caller checks a repair order",
      "description": "Tier 2. The caller asks about a repair order and reads the number out.",
      "lang": "en",
      "caller": "13800001111",
      "callerPersona": {
        "goal": "Find out where your phone repair is. When asked for the repair order number, give it. Once you have the status, say thanks and goodbye.",
        "persona": "Your repair order number is RMA1001. You say it as R M A one zero zero one.",
        "behaviour": "Polite."
      },
      "model": {"visits": ["repair_report"], "avoids": ["need_transfer"]}
    }
  ]
}
