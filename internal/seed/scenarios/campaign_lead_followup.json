    {
      "name": "a stance and the hangup in one response still end in the finish phase with its own line",
      "description": "The model may send record_lead and hangup together (#262). The batch is judged in the phase it was made in and the hangup moves the call to finish, whose line is said as written. The simulator runs only the flow: that the caller then hears that line, and not the model's own confirmation, is held by internal/aicall (closing-line accounting).",
      "lang": "en",
      "isCampaign": true,
      "caller": "18688886666",
      "steps": [
        {"say": "Sounds good, send me the details. Bye."},
        {"batch": [
          {"call": "record_lead", "args": {"intent": "HIGH", "notes": "wants the details"}},
          {"call": "hangup"}
        ], "expect": {"phase": "finish", "announce": "Thank you for your time, and sorry for the interruption. Have a good day, goodbye."}}
      ],
      "expect": {"path": ["talk", "finish"], "ending": "hangup", "toolsRun": ["record_lead", "hangup"], "lead": {"intent": "HIGH"}}
    },
