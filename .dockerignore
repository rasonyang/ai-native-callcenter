# SPDX-License-Identifier: Apache-2.0
#
# Everything the image build does not read. The build compiles the frontend and
# the Go binary from source, so build output, dependencies and local state are
# all noise that would only invalidate layer caches.

.git
.github
bin/
dist/
logs/
recordings/

# The image builds the SPA itself; a host build must not leak in.
web/node_modules/
web/dist/
web/tsconfig.tsbuildinfo
web/src/routeTree.gen.ts

# Local configuration and scratch state.
.env
*.log
.DS_Store

# Deployment material is not an input to the binary.
deploy/
freeswitch/
prompts.md

# docs/ is not documentation as far as the build is concerned: docs/embed.go
# is a Go package and docs/openapi.json is embedded into the binary, because a
# deployment that cannot hand out its own contract asks every integrator to
# trust a copy found somewhere else. Excluding the directory made the image
# build fail with "no required module provides package .../docs" while
# `go build ./...` on a workstation passed. Everything under docs/ that is
# genuinely prose is excluded below instead.
docs/design/
docs/*.md
docs/auth/
docs/assets/
