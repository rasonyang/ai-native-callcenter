# SPDX-License-Identifier: Apache-2.0
#
# Settings of the stack: cp .env.example .env, then fill in the two lines that
# are not commented out. Every commented line shows the value already in use.

# The address phones reach this host at, an IP or a hostname. Nothing inside
# compose can work it out, and it goes into the SDP and the Contact, so a
# softphone given the wrong one registers and hears nothing.
FS_EXTERNAL_IP=

# The bot answers on qwen unless AICC_PROVIDER says otherwise, so this is the
# key it needs. Without one the switch, the flows, the queues and the history
# all work and only the bot has nothing to say.
ALIYUN_API_KEY=

# Outside mainland China, uncomment both of these instead.
#AICC_PROVIDER=openai
#OPENAI_API_KEY=

# PostgreSQL, the switch's confined database role, the event socket. Change all
# three before this faces anybody.
#POSTGRES_PASSWORD=aicc@123
#LUA_PASSWORD=aicc@123
#ESL_PASSWORD=aicc@123

# Where it listens. The two RTP values configure the switch and publish the
# ports, so change them together. SWITCH_DOMAIN defaults to FS_EXTERNAL_IP.
#HTTP_BIND=0.0.0.0
#HTTP_PORT=8080
#SIP_BIND=0.0.0.0
#RTP_START=16384
#RTP_END=16484
#SWITCH_DOMAIN=

# The switch dials the bot by IP, so the application holds a fixed address on
# the compose network. Change both together if this range is taken here.
#AICC_SUBNET=10.130.0.0/24
#AICC_APP_IP=10.130.0.10

# By default the application is built from this checkout on first start: a few
# minutes, then seconds afterwards. That is what keeps the stack and the
# documentation in step before a release is cut. Set AICC_IMAGE to a published
# tag to skip the build; exact release tags only, there is no `latest`.
#AICC_IMAGE=ghcr.io/rasonyang/ai-native-callcenter:v0.1.0-rc.1
#AICC_VERSION=local
#AICC_FS_IMAGE=rasonyang/freeswitch-aicc:v1.11.3
#AICC_LOG_LEVEL=info

# The sample dataset. Unset means demo: accounts, queues, six published flows
# with their numbers, a week of history. An empty value seeds nothing, which is
# what belongs on a host anybody else can reach. `fresh` removes what it made.
#AICC_SEED=demo

# Any other AICC_* line placed in this file reaches the application unchanged;
# the registry of every setting is the repository's root .env.example. Two of
# its semantics apply here too: an empty value means unset, so the default
# wins, and everything after the first `=` is the value, comments included.
