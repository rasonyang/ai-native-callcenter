<!--
  SPDX-License-Identifier: Apache-2.0

  Design 01 §7 diff D3. Binding the XML handler is what makes the database the
  switch's configuration: extensions come from the directory section and queues
  from the callcenter.conf section, both answered by aicc_xml.lua.

  Binding takes a restart rather than a reload — mod_lua reads these parameters
  when it loads and is not unloadable. In a container that is simply what a
  boot is.
-->
<configuration name="lua.conf" description="LUA Configuration">
  <settings>
    <param name="xml-handler-script" value="aicc_xml.lua"/>
    <param name="xml-handler-bindings" value="directory|configuration"/>
  </settings>
</configuration>
