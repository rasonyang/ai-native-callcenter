<!--
  SPDX-License-Identifier: Apache-2.0

  The application's one connection to the switch. Port 18021, not the stock
  8021, matching AICC_ESL_ADDR's documented default everywhere else in this
  project.

  The listener is reachable from the compose network only — no port is
  published for it — which is the whole of its access control. The password is
  substituted at boot from the compose environment.

  IPv4 explicitly: the compose network has no IPv6, and mod_event_socket
  answers a bind on :: there by refusing to start its thread at all.
-->
<configuration name="event_socket.conf" description="Socket Client">
  <settings>
    <param name="nat-map" value="false"/>
    <param name="listen-ip" value="0.0.0.0"/>
    <param name="listen-port" value="18021"/>
    <param name="password" value="@ESL_PASSWORD@"/>
    <!-- Defined in acl.conf.xml: this container and the compose network. -->
    <param name="apply-inbound-acl" value="aicc_esl"/>
    <param name="stop-on-bind-error" value="true"/>
  </settings>
</configuration>
