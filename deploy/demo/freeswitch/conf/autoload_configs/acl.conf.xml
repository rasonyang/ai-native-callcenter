<!--
  SPDX-License-Identifier: Apache-2.0

  The stock network lists, plus the one the event socket uses.

  Left unset, mod_event_socket applies loopback.auto and rudely rejects the
  application, which lives in another container. localnet.auto alone would let
  the application in but shut fs_cli out of its own container, which is where
  anyone debugging this demo will reach for it. "aicc_esl" is both.
-->
<configuration name="acl.conf" description="Network Lists">
  <network-lists>

    <list name="aicc_esl" default="deny">
      <node type="allow" cidr="127.0.0.0/8"/>
      <node type="allow" cidr="::1/128"/>
      <!-- The compose network. RFC1918 is as wide as a bridge network gets,
           and nothing outside this host can reach the port at all: it is
           deliberately not published. -->
      <node type="allow" cidr="10.0.0.0/8"/>
      <node type="allow" cidr="172.16.0.0/12"/>
      <node type="allow" cidr="192.168.0.0/16"/>
    </list>

    <list name="lan" default="allow">
      <node type="deny" cidr="192.168.42.0/24"/>
      <node type="allow" cidr="192.168.42.42/32"/>
    </list>

    <!-- Scans the directory for users with a cidr= tag, as stock. -->
    <list name="domains" default="deny">
      <node type="allow" domain="$${domain}"/>
    </list>

  </network-lists>
</configuration>
