<!--
  SPDX-License-Identifier: Apache-2.0

  The simulated customers: eighteen "mobile phones" any SIP softphone can
  register as, password aicc@123. They stand in for the public network, so a
  call they place enters the switch the way a carrier's would (user_context
  public, the inbound doorway) and carries their number as caller id. They are
  not accounts of the product: no aicc_managed, no extension, no presence.

  Mounted into conf/directory/default/, which the switch consults only for a
  number the database does not know.
-->
<include>
    <user id="13800000001">
      <params>
        <param name="password" value="aicc@123"/>
      </params>
      <variables>
        <variable name="user_context" value="public"/>
        <variable name="effective_caller_id_name" value="13800000001"/>
        <variable name="effective_caller_id_number" value="13800000001"/>
        <variable name="aicc_simulated_pstn" value="true"/>
      </variables>
    </user>
