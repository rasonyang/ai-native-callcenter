<!--
  SPDX-License-Identifier: Apache-2.0

  The dialplan context every aicc-managed SIP account lives in.

  aicc_xml.lua puts each account it serves into this context, so everything an
  agent phone can dial is decided here and nowhere else. That is the whole
  point: the stock dialplan is left untouched, and this file is the only place
  a reader has to look to know what an extension reaches.

  It replaces an earlier arrangement in which agents sat in the stock `default`
  context and extension-to-extension dialling was left to the stock
  `Local_Extension` rule (design 01 §7 D6). That rule works as telephony and
  fails as a call centre: the legs it raises carry none of the aicc variables,
  so the application sees an unattributed pair of channels, mints a call of its
  own around them and gets both the direction and the roles wrong — the agent
  being rung was shown "Calling out" and their caller's leg. It also falls
  through to voicemail on no-answer, and each successor leg becomes its own CDR
  row (C24). Neither is a thing to patch around downstream; both disappear by
  not routing aicc calls through rules that were never about aicc.

  Nothing from the stock context is inherited. Feature codes an agent phone
  never uses — call pickup, park, redial, the voicemail keys — are absent by
  choice rather than by oversight. Anything an agent genuinely needs is added
  here explicitly, which keeps the reachable surface of a call centre phone
  something you can read in one screen.
-->
<include>
  <context name="aicc">

    <!--
      Queue extensions. The bot transfers a caller here when it calls
      transfer_to_agent, and aicc_inbound falls back here when the bot cannot
      take a call at all. Which queue serves which extension is a database
      question, so the script answers it.
    -->
    <extension name="aicc_queue">
      <condition field="destination_number" expression="^(7\d{3})$">
        <action application="lua" data="aicc_queue.lua $1"/>
      </condition>
    </extension>

    <!--
      One agent phone calling another.

      The two exports are what the application needs and what the stock rule
      never gave it.

      aicc_parent_channel names the channel this bridge was raised for, so the
      second leg can be recognised as the other half of the first one's call.
      It cannot be a call id: the caller's CHANNEL_CREATE reaches the
      application before this dialplan runs, so the caller can never carry its
      own identity in time — whichever leg the identity is minted on, the other
      one has already been adopted into a call of its own. A pointer back to
      the first leg has no such race, and it is the mechanism mod_callcenter
      already supplies for queue deliveries (cc_member_session_uuid).
      export puts the value on both legs; the leg that names itself is the
      caller, which is how they are told apart.

      Without it the second leg is adopted into a provisional call of its own,
      becomes that call's first party, and is therefore rendered ORIGINATOR and
      DIALING — the agent being rung is shown dialling the person calling them.

      aicc_call_type says INTERNAL where the switch would only see an outbound
      leg and guess OUTBOUND — the type is decided here, where the destination
      is still known to be an extension.

      continue_on_fail is false on purpose. An internal call nobody answers is
      an internal call nobody answered; there is no voicemail to fall into and
      no successor leg to write a second record for.
    -->
    <extension name="aicc_internal">
      <condition field="destination_number" expression="^(10[0-9][0-9])$">
        <action application="export" data="aicc_parent_channel=${uuid}"/>
        <action application="export" data="aicc_call_type=INTERNAL"/>
        <action application="set" data="hangup_after_bridge=true"/>
        <action application="set" data="continue_on_fail=false"/>
        <action application="set" data="call_timeout=30"/>
        <action application="set" data="ringback=${us-ring}"/>
        <action application="bridge" data="user/$1@${domain_name}"/>
      </condition>
    </extension>

    <!--
      Where a deployment adds what only it has: this laptop's simulated PSTN
      trunk, somebody else's carrier, a feature code a particular floor needs.

      It has to be an include rather than a second file declaring this context
      again. Two files that both open <context name="aicc"> do not merge — the
      first is used and the second is silently ignored, so its rules are
      visible to xml_locate and unreachable to a call. That cost an afternoon:
      a trunk rule sat in a second file, every outbound click-to-dial reached
      the dialplan and found nothing, and the leg hung up NO_ROUTE_DESTINATION
      while the rule appeared to be right there.
    -->
    <X-PRE-PROCESS cmd="include" data="aicc/*.xml"/>

  </context>
</include>
