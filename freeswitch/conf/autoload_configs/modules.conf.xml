         formats, and so does mod_http_cache below. Only one of them can have
         them, and this product needs the one that can write. -->
    <!-- <load module="mod_httapi"/> -->
    <!-- Recordings may go to an http:// object store rather than a directory
         (aicc_recordings_dir in vars.xml). With this module loaded and
         enable-file-formats true in http_cache.conf.xml, record_session takes
         a URL and the switch uploads each finished recording itself, with no
         volume shared between it and the application. Without it the URL is
         rejected as an unknown file format and nothing is recorded. -->
    <load module="mod_http_cache"/>
