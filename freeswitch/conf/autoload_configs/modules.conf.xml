    <!-- Third party modules -->
    <!--<load module="mod_nibblebill"/>-->
    <!-- The queue engine. Vanilla ships it commented out; here it is the
         thing agents are delivered calls by, and its queues and agents are
         rendered from PostgreSQL by aicc_xml.lua rather than written below.
         It is loaded last, after mod_lua, because it reads its configuration
         through that binding: loaded first it would find no queues and say
         nothing about why. -->
    <load module="mod_callcenter"/>

    <!-- Live transcription taps an agent's leg with uuid_audio_stream and
         sends the audio to the application over a websocket. Not a stock
         FreeSWITCH module — it is built into this image from source, and the
         build must declare libspeexdsp or the tap resamples at the wrong rate
         (freeswitch/assert-audio-stream.sh checks exactly that). Without the
         module the stack still comes up entirely healthy and transcribes
         nothing at all, which is why it is loaded unconditionally here: a
         missing module must be a boot failure, not a transcript panel that
         says "Connecting..." until the call ends. -->
    <load module="mod_audio_stream"/>

